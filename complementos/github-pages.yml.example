# Ejemplo inactivo. Copiar a .github/workflows/pages.yml cuando el usuario
# autorice publicar. Requiere dist/ y pruebas en la raíz del proyecto final.
# Si cambia el stack, adaptar instalación/compilación y ruta del artifact.
name: Publicar gestor Zombicide

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  comprobar-y-preparar:
    runs-on: ubuntu-latest
    steps:
      - name: Obtener código
        uses: actions/checkout@v6
      - name: Preparar catalogo y recursos offline
        run: node scripts/preparar.mjs
      - name: Comprobar motor
        run: node --test tests/*.test.js
      - name: Preparar Pages
        uses: actions/configure-pages@v5
      - name: Empaquetar aplicación estática
        uses: actions/upload-pages-artifact@v4
        with:
          path: ./dist

  publicar:
    needs: comprobar-y-preparar
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.publicacion.outputs.page_url }}
    steps:
      - name: Publicar
        id: publicacion
        uses: actions/deploy-pages@v4
